APP_NAME="Lymity AI Agency"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://187.124.133.195:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
APP_TIMEZONE=America/Sao_Paulo

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lymity_ia
DB_USERNAME=lymity
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=lymity_

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_QUEUE_DB=1
REDIS_SESSION_DB=2
REDIS_CACHE_DB=3

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@lymity.com.br"
MAIL_FROM_NAME="${APP_NAME}"

# Anthropic / Claude AI
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=4096

# OpenAI (backup)
OPENAI_API_KEY=

# Google Ads
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

# Meta / Instagram Publishing
# Auth modes: facebook_business_login (recomendado), instagram_business_login, facebook_login (legado)
META_AUTH_MODE=facebook_business_login
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://ia.lymity.com.br/admin/social/instagram/callback
META_GRAPH_VERSION=v25.0
# Escopos business obrigatórios para apps Meta publicados (não usar instagram_basic ou instagram_content_publish)
META_FACEBOOK_SCOPES=instagram_business_basic,instagram_business_content_publish
META_INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_content_publish
INSTAGRAM_PUBLISHING_ENABLED=false
META_ACCESS_TOKEN=

# Google Analytics
GOOGLE_ANALYTICS_PROPERTY_ID=

# Google Search Console
GOOGLE_SEARCH_CONSOLE_SITE_URL=

# AWS S3 (media storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Pusher / Reverb (real-time)
BROADCAST_DRIVER=log
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# Admin geral padrão (seed)
ADMIN_NAME="Renato Peres"
ADMIN_EMAIL=renatoperes300@gmail.com
ADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY=
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=mock-growth-agent
AI_MAX_TOKENS=1200
AI_TEMPERATURE=0.7
AI_MONTHLY_BUDGET_LIMIT=100
AI_DAILY_TASK_LIMIT=50
AI_REAL_ENABLED=false
AI_FALLBACK_TO_MOCK=false

# Google Drive Integration (Phase 13)
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=

# === GEMINI — TEXTO E IMAGEM ===
AI_PROVIDER=google
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_TEXT_FALLBACK_MODEL=gemini-2.5-flash-lite
GEMINI_IMAGE_MODEL=imagen-3.0-generate-002
AI_ENABLE_GROUNDING=false
AI_ENABLE_CONTEXT_CACHE=false
AI_REQUIRE_APPROVAL=true
AI_DAILY_REQUEST_LIMIT=20
AI_MONTHLY_BUDGET_USD=20
AI_MAX_OUTPUT_TOKENS=3500
AI_TEMPERATURE=0.7
AI_TEXT_ONLY_MODE=false
AI_IMAGE_GENERATION_ENABLED=true

# === INSTAGRAM OFICIAL @lymity.ia ===
INSTAGRAM_OFFICIAL_USERNAME=lymity.ia
INSTAGRAM_OFFICIAL_PAGE_ID=1069242536283477
INSTAGRAM_OFFICIAL_IG_USER_ID=17841434234661171

# === SOCIAL IMAGE STORAGE ===
SOCIAL_IMAGE_DISK=public
SOCIAL_IMAGE_PATH=social/generated
SOCIAL_IMAGE_PUBLIC_BASE_URL=https://ia.lymity.com.br/storage
